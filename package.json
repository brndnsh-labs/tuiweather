{
  "name": "tuiweather",
  "version": "0.4.0",
  "description": "Keyboard-driven terminal weather app powered by Open-Meteo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tuiweather": "bin/tuiweather.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brndnsh-labs/tuiweather.git"
  },
  "homepage": "https://github.com/brndnsh-labs/tuiweather#readme",
  "bugs": "https://github.com/brndnsh-labs/tuiweather/issues",
  "keywords": [
    "tui",
    "weather",
    "terminal",
    "cli",
    "open-meteo",
    "forecast"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "preview": "bun scripts/preview.tsx",
    "build": "bun build ./src/index.tsx --outdir dist --target node --external '@opentui/core-*'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.3.0",
    "smol-toml": "^1.8.0",
    "zod": "4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
