{
  "name": "tuiweather",
  "version": "0.0.0",
  "description": "Keyboard-driven terminal weather app powered by Open-Meteo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build ./src/index.tsx --outdir dist --target bun --external '@opentui/core-*'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/react": "^0.5.8",
    "react": "^19.2.8",
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
