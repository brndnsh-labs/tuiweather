{
  "name": "tuiweather",
  "version": "0.3.6",
  "description": "Keyboard-driven terminal weather app powered by Open-Meteo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tuiweather": "bin/tuiweather.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brndnsh-labs/tuiweather.git"
  },
  "homepage": "https://github.com/brndnsh-labs/tuiweather#readme",
  "bugs": "https://github.com/brndnsh-labs/tuiweather/issues",
  "keywords": [
    "tui",
    "weather",
    "terminal",
    "cli",
    "open-meteo",
    "forecast"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build ./src/index.tsx --outdir dist --target node --external '@opentui/core-*'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "react": "^19.2.8",
    "smol-toml": "^1.8.0",
    "zod": "4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
